+// Stream buffer aliasing a caller-owned memory block.
+// std::stringbuf::pubsetbuf() is implementation-defined: libstdc++ adopts the buffer, libc++
+// (macOS/clang) ignores it, so reads never reach the mapper ("Number of input reads | 0").
+class FixedMemBuf : public std::streambuf {
+public:
+    FixedMemBuf(char* buf, std::size_t n) : size_((off_type) n) {
+        setg(buf, buf, buf + n);
+        setp(buf, buf + n);
+    }
+protected:
+    pos_type seekoff(off_type off, std::ios_base::seekdir dir, std::ios_base::openmode which) override {
+        pos_type bad = pos_type(off_type(-1));
+        if ((which & std::ios_base::in) == (which & std::ios_base::out)) return bad;//exactly one of in/out
+        off_type cur = (which & std::ios_base::in) ? gptr() - eback() : pptr() - pbase();
+        off_type pos = dir == std::ios_base::beg ? off : (dir == std::ios_base::cur ? cur + off : size_ + off);
+        if (pos < 0 || pos > size_) return bad;
+        if (which & std::ios_base::in) {
+            setg(eback(), eback() + pos, egptr());
+        } else {
+            pbump((int) (pos - cur));
+        };
+        return pos_type(pos);
+    }
+    pos_type seekpos(pos_type pos, std::ios_base::openmode which) override {
+        return seekoff(off_type(pos), std::ios_base::beg, which);
+    }
+private:
+    off_type size_;
+};
